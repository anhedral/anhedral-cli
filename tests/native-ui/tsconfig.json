{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["jest"],
    "paths": {
      "@workspace/styling": ["./.generated/styling/src/index.ts"]
    },
    "noUncheckedIndexedAccess": true
  },
  "include": [".generated/**/*.ts", ".generated/**/*.tsx", "*.ts", "*.tsx"],
  "extends": "expo/tsconfig.base"
}
