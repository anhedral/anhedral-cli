{
  "name": "@workspace/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "@workspace/eslint-config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "wrangler": "4.149.0"
  }
}
