{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "full-stack-web",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
