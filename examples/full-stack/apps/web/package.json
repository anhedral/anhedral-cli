{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "start": "vinext start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && tsc --noEmit",
    "preview": "wrangler dev --config dist/server/wrangler.json --port 3000 --persist-to .wrangler/state",
    "deploy": "vite build && wrangler deploy --config dist/server/wrangler.json",
    "build:worker": "vite build"
  },
  "dependencies": {
    "@workspace/ui": "workspace:*",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vinext": "1.1.0",
    "react-server-dom-webpack": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@next/eslint-plugin-next": "16.4.2",
    "@typescript-eslint/parser": "8.71.2",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "vite": "8.3.4",
    "@cloudflare/vite-plugin": "1.63.1",
    "@vitejs/plugin-rsc": "0.5.36",
    "@vitejs/plugin-react": "6.1.2",
    "wrangler": "4.149.0"
  }
}
