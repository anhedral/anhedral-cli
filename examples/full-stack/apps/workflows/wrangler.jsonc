{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "full-stack-workflows",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "workflows": [
    {
      "name": "full-stack-workflow",
      "binding": "WORKFLOW",
      "class_name": "ApplicationWorkflow"
    }
  ]
}
