{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "full-stack-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "full-stack-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "full-stack-jobs",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "full-stack-jobs-dlq"
      }
    ]
  }
}
