diff --git a/lib/limits.js b/lib/limits.js
new file mode 100644
--- /dev/null
+++ b/lib/limits.js
@@ -0,0 +1,44 @@
+'use strict';
+
+const MAX_DEPTH = 100;
+const fail = () => {
+  throw new RangeError(`braces nesting exceeds maximum depth of ${MAX_DEPTH}`);
+};
+
+// Preflight recursive walkers iteratively. The root is not a nesting level;
+// leaves do not add a level. Normal parent links are intentionally separate
+// from child traversal, since a parsed AST links each child to its parent.
+const checkAst = (ast, checkParents = false) => {
+  const active = new Set();
+  const stack = [{ node: ast, depth: 0, root: true }];
+  while (stack.length) {
+    const frame = stack.pop();
+    const node = frame.node;
+    if (!node || typeof node !== 'object') continue;
+    if (frame.exit) {
+      active.delete(node);
+      continue;
+    }
+    if (active.has(node)) fail();
+    const children = Array.isArray(node.nodes) ? node.nodes : [];
+    const depth = frame.depth + (Array.isArray(node.nodes) && !(frame.root && node.type === 'root') ? 1 : 0);
+    if (depth > MAX_DEPTH) fail();
+    if (checkParents) {
+      const parents = new Set();
+      let parent = node;
+      let count = 0;
+      while (parent && parent.type !== 'brace' && parent.type !== 'root' && parent.parent) {
+        if (parents.has(parent) || ++count > MAX_DEPTH + 1) fail();
+        parents.add(parent);
+        parent = parent.parent;
+      }
+    }
+    active.add(node);
+    stack.push({ node, exit: true });
+    for (let index = children.length - 1; index >= 0; index--) {
+      stack.push({ node: children[index], depth });
+    }
+  }
+};
+
+module.exports = { MAX_DEPTH, checkAst };
