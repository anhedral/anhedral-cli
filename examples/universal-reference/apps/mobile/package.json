{
  "name": "universal-reference-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "pnpm build:web && wrangler dev --port 3000 --inspector-port 9230",
    "android": "expo start -c --android",
    "ios": "expo start -c --ios",
    "web": "pnpm dev",
    "build": "pnpm typecheck && pnpm build:web && pnpm build:worker",
    "build:web": "expo export --platform web",
    "eas:login": "pnpm dlx eas-cli@21.0.1 login",
    "build:simulator:ios": "pnpm dlx eas-cli@21.0.1 build --platform ios --profile simulator",
    "build:internal:ios": "pnpm dlx eas-cli@21.0.1 build --platform ios --profile preview",
    "build:internal:android": "pnpm dlx eas-cli@21.0.1 build --platform android --profile preview",
    "build:production:ios": "pnpm dlx eas-cli@21.0.1 build --platform ios --profile production",
    "build:production:android": "pnpm dlx eas-cli@21.0.1 build --platform android --profile production",
    "typecheck": "tsc --noEmit && pnpm typecheck:worker",
    "lint": "eslint app components lib worker --max-warnings 0",
    "start": "expo start -c",
    "build:worker": "wrangler deploy --dry-run --outdir .output/worker",
    "preview": "pnpm build:web && wrangler dev --port 3000 --inspector-port 9230",
    "deploy": "pnpm build:web && wrangler deploy",
    "typecheck:worker": "tsc --project tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.7",
    "@rn-primitives/portal": "1.5.2",
    "@workspace/contracts": "workspace:*",
    "@workspace/styling": "workspace:*",
    "better-auth": "1.7.7",
    "clsx": "2.1.1",
    "expo": "57.0.8",
    "expo-dev-client": "57.0.20",
    "expo-linking": "57.0.4",
    "expo-network": "57.0.2",
    "expo-router": "57.0.8",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-css-interop": "0.2.6",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@react-native/metro-config": "0.86.0",
    "@testing-library/dom": "10.4.1",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@workspace/eslint-config": "workspace:*",
    "babel-preset-expo": "57.0.14",
    "eslint": "10.0.3",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  }
}
