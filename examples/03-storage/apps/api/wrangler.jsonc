{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "example-app-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "example-app-files"
    }
  ]
}
