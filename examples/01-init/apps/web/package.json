{
  "name": "@workspace/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/oj.mjs dev . --host=0.0.0.0 --port 3000",
    "build": "node ../../scripts/oj.mjs build .",
    "preview": "wrangler dev --config dist/ssr/wrangler.json --port 3000",
    "deploy": "wrangler deploy --config dist/ssr/wrangler.json",
    "typecheck": "wrangler types && tsr generate && tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-router": "1.170.46",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.5.0",
    "@workspace/styling": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@tanstack/router-cli": "1.167.46",
    "@vitejs/plugin-react": "6.2.1",
    "vite": "8.3.5",
    "wrangler": "4.156.1",
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "9.39.5",
    "@workspace/eslint-config": "workspace:*"
  }
}
