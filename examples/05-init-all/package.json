{
  "name": "example-app",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "turbo build --concurrency=1",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "audit:deps": "node scripts/audit-deps.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --filter @workspace/web dev",
    "db:generate": "pnpm --dir packages/db db:generate",
    "db:migrate": "pnpm --dir packages/db db:migrate",
    "dev:mobile": "pnpm --dir apps/mobile dev",
    "dev:cli": "pnpm --dir apps/cli dev",
    "dev:web-extension": "pnpm --dir apps/web-extension dev",
    "dev:desktop": "pnpm --dir apps/desktop dev"
  },
  "devDependencies": {
    "turbo": "2.11.7"
  }
}
