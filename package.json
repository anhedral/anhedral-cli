{
  "name": "anhedral",
  "version": "0.22.0",
  "description": "The open-source Anhedral API client for building, configuring and deploying apps, with editable source generation.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./deployment": {
      "types": "./dist/contracts/deployment.d.ts",
      "import": "./dist/contracts/deployment.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "anhedral": "dist/bin.js"
  },
  "files": [
    "dist",
    "assets/patches/braces@3.0.3.patch",
    "assets/patches/LICENSE.braces",
    "assets/patches/node-forge@1.4.0.patch",
    "assets/patches/LICENSE.node-forge",
    "assets/patches/audit-deps.mjs",
    "LICENSE",
    "README.md",
    "docs/stack-standard.md",
    "docs/software-factory.md",
    "docs/verification.md",
    "docs/ui.md",
    "assets/stack",
    "docs/capabilities.md",
    "assets/ui/web",
    "assets/ui/LICENSE.shadcn",
    "assets/ui/UPSTREAM.json",
    "assets/contracts",
    "assets/security",
    "assets/launch"
  ],
  "homepage": "https://github.com/anhedral/anhedral-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhedral/anhedral-cli.git"
  },
  "bugs": {
    "url": "https://github.com/anhedral/anhedral-cli/issues"
  },
  "author": "Anhedral, Inc.",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "scaffold": "node dist/bin.js init",
    "clean": "node scripts/build/clean.mjs",
    "build": "node scripts/checks/standalone-checkout.mjs && pnpm clean && tsc && node scripts/build/prepare-cli.mjs",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "check:hygiene": "node scripts/checks/check-source-hygiene.mjs && node scripts/contracts/check-environment-contract.mjs && node scripts/contracts/check-operations-contract.mjs",
    "check:security": "node scripts/security/check-security-policy.mjs",
    "check:release-policy": "node scripts/release/check-release-policy.mjs",
    "check:release-secrets": "node scripts/release/check-release-secrets.mjs",
    "lint": "pnpm typecheck && pnpm format:check && pnpm check:hygiene && pnpm check:release-policy && pnpm check:boundaries",
    "audit:osv": "node scripts/security/audit-osv.mjs",
    "test": "pnpm test:unit",
    "pretest": "pnpm build",
    "prepublishOnly": "pnpm test:all",
    "test:cli:validation": "node --test tests/test-cli-validation.test.mjs",
    "test:pack": "pnpm build && node tests/test-packed-cli.js",
    "test:pack:exact": "node tests/test-packed-cli.js .artifacts/release/metadata.json",
    "test:packlist": "pnpm build && node tests/test-packlist.js",
    "test:release-tooling": "node tests/test-release-tooling.test.mjs",
    "test:all": "pnpm build && pnpm format:check && pnpm check:hygiene && pnpm check:release-policy && pnpm check:boundaries && pnpm check:security && pnpm audit:osv && pnpm test:unit && pnpm test:patch && node tests/test-packed-cli.js && node tests/test-packlist.js",
    "release:check": "pnpm test:all",
    "release:pack": "pnpm build && pnpm plugin:build && node scripts/release/create-release-artifact.mjs && node scripts/release/check-release-secrets.mjs .artifacts/release/metadata.json",
    "release:artifact:verify": "node scripts/release/verify-release-artifact.mjs .artifacts/release/metadata.json && node scripts/release/check-release-secrets.mjs .artifacts/release/metadata.json",
    "release:artifact:smoke": "node tests/test-packed-cli.js .artifacts/release/metadata.json",
    "test:unit": "node --test --test-concurrency=4 --test-reporter=spec tests/*.test.mjs",
    "test:integration": "pnpm build && node tests/test-generated-apps.mjs",
    "format": "prettier --write src scripts tests \"assets/patches/*.mjs\" assets/ui assets/security && node scripts/build/stack-template-format.mjs --write",
    "format:check": "prettier --check src scripts tests \"assets/patches/*.mjs\" assets/ui assets/security && node scripts/build/stack-template-format.mjs",
    "plugin:build": "node scripts/plugin/check-plugin.mjs",
    "plugin:check": "node scripts/plugin/check-plugin.mjs",
    "test:patch": "node tests/test-braces-install.mjs && node tests/test-forge-install.mjs",
    "check:boundaries": "node scripts/checks/repository-boundaries.mjs",
    "test:tanstack-runtime": "pnpm build && node scripts/runtime/tanstack-runtime-smoke.mjs",
    "check:standalone": "node scripts/checks/standalone-checkout.mjs"
  },
  "keywords": [
    "cli",
    "scaffold",
    "typescript",
    "anhedral-stack",
    "tanstack-start",
    "hono",
    "better-auth",
    "cloudflare",
    "d1",
    "r2",
    "drizzle",
    "stripe"
  ],
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@types/node": "20.19.43",
    "hono": "4.13.13",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.6",
    "ignore": "7.0.14"
  }
}
