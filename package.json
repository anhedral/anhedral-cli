{
  "name": "anhedral",
  "version": "0.11.0",
  "description": "Build and deliver applications with Cloudflare-first Vinext, selected services, optional Next.js on Vercel, and verified release evidence.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "anhedral": "dist/bin.js"
  },
  "files": [
    "dist",
    "assets/anhedral-stack.svg",
    "assets/anhedral-stack-technical.svg",
    "assets/anhedral-mark.svg",
    "LICENSE",
    "README.md",
    "assets/anhedral.svg",
    "assets/favicon.ico",
    "docs/application-stack-standard.md",
    "docs/delivery-workflow.md",
    "docs/provider-configuration.md",
    "docs/cli-design.md",
    "assets/security",
    "docs/plugin-ui.md"
  ],
  "homepage": "https://github.com/anhedral/anhedral-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhedral/anhedral-cli.git"
  },
  "bugs": {
    "url": "https://github.com/anhedral/anhedral-cli/issues"
  },
  "author": "Anhedral, Inc.",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "scaffold": "node dist/bin.js init",
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && tsc && node scripts/prepare-cli.mjs",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "check:hygiene": "node scripts/check-source-hygiene.mjs",
    "check:security": "node scripts/check-security-policy.mjs",
    "check:release-policy": "node scripts/check-release-policy.mjs",
    "check:release-secrets": "node scripts/check-release-secrets.mjs",
    "lint": "pnpm typecheck && pnpm format:check && pnpm check:hygiene && pnpm check:release-policy",
    "audit:osv": "node scripts/audit-osv.mjs",
    "test": "pnpm test:unit",
    "pretest": "pnpm build",
    "prepublishOnly": "pnpm test:all",
    "test:cli:validation": "node --test tests/test-cli-validation.test.mjs",
    "test:pack": "pnpm build && node tests/test-packed-cli.js",
    "test:pack:exact": "node tests/test-packed-cli.js .artifacts/release/metadata.json",
    "test:packlist": "pnpm build && node tests/test-packlist.js",
    "test:release-tooling": "node tests/test-release-tooling.test.mjs",
    "test:all": "pnpm build && pnpm lint && pnpm check:security && pnpm audit:osv && pnpm test:unit && node tests/test-packed-cli.js && node tests/test-packlist.js",
    "release:check": "pnpm test:all",
    "release:pack": "pnpm build && pnpm plugin:build && node scripts/create-release-artifact.mjs && node scripts/check-release-secrets.mjs .artifacts/release/metadata.json",
    "release:artifact:verify": "node scripts/verify-release-artifact.mjs .artifacts/release/metadata.json && node scripts/check-release-secrets.mjs .artifacts/release/metadata.json",
    "release:artifact:smoke": "node tests/test-packed-cli.js .artifacts/release/metadata.json",
    "docs:stack-map": "node scripts/render-master-stack-map.mjs",
    "docs:technical-stack-map": "node scripts/render-master-stack-map.mjs --technical",
    "docs:stack-maps": "pnpm docs:stack-map && pnpm docs:technical-stack-map",
    "test:standard": "pnpm build && node --test tests/test-standard.test.mjs",
    "test:unit": "node --test --test-concurrency=4 --test-reporter=spec tests/*.test.mjs",
    "test:integration": "pnpm build && node tests/test-generated-apps.mjs",
    "test:live:delivery": "pnpm build && node tests/test-live-delivery.mjs",
    "test:live:vercel": "pnpm build && node tests/test-live-vercel.mjs",
    "test:live:vercel:git": "pnpm build && node tests/test-live-vercel-git.mjs",
    "format": "prettier --write src scripts tests plugin-app",
    "format:check": "prettier --check src scripts tests plugin-app",
    "plugin:build": "pnpm --dir plugin-app build",
    "plugin:check": "pnpm --dir plugin-app check",
    "plugin:preview": "pnpm --dir plugin-app start"
  },
  "keywords": [
    "cli",
    "scaffold",
    "typescript",
    "nextjs",
    "hono",
    "cloudflare",
    "opennext",
    "expo",
    "electron",
    "wxt",
    "neon",
    "drizzle",
    "shadcn",
    "turborepo",
    "vinext"
  ],
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@types/node": "20.19.43",
    "prettier": "3.9.10",
    "simple-icons": "16.27.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
