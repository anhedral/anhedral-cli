{
  "name": "anhedral",
  "version": "0.15.0",
  "description": "Create a Next.js web + native Expo + Hono + Drizzle/D1 + private R2 application. Add Stripe and RevenueCat when needed.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "anhedral": "dist/bin.js"
  },
  "files": [
    "dist",
    "assets/patches/braces@3.0.3.patch",
    "assets/patches/LICENSE.braces",
    "assets/patches/node-forge@1.4.0.patch",
    "assets/patches/LICENSE.node-forge",
    "assets/patches/audit-deps.mjs",
    "LICENSE",
    "README.md",
    "docs/stack-standard.md",
    "docs/software-factory.md",
    "docs/verification.md",
    "docs/anhedral-stack.md",
    "docs/assets/anhedral-stack.png",
    "docs/assets/anhedral-stack-light.png",
    "assets/ui",
    "docs/native-ui.md",
    "!assets/ui/official/**",
    "docs/native-registry.md"
  ],
  "homepage": "https://github.com/anhedral/anhedral-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhedral/anhedral-cli.git"
  },
  "bugs": {
    "url": "https://github.com/anhedral/anhedral-cli/issues"
  },
  "author": "Anhedral, Inc.",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "scaffold": "node dist/bin.js init",
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && tsc && node scripts/prepare-cli.mjs",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "check:hygiene": "node scripts/check-source-hygiene.mjs",
    "check:security": "node scripts/check-security-policy.mjs",
    "check:release-policy": "node scripts/check-release-policy.mjs",
    "check:release-secrets": "node scripts/check-release-secrets.mjs",
    "lint": "pnpm typecheck && pnpm format:check && pnpm check:hygiene && pnpm check:release-policy",
    "audit:osv": "node scripts/audit-osv.mjs",
    "test": "pnpm test:unit",
    "pretest": "pnpm build",
    "prepublishOnly": "pnpm test:all",
    "test:cli:validation": "node --test tests/test-cli-validation.test.mjs",
    "test:contracts:types": "node tests/test-generated-contracts-types.mjs",
    "test:pack": "pnpm build && node tests/test-packed-cli.js",
    "test:pack:exact": "node tests/test-packed-cli.js .artifacts/release/metadata.json",
    "test:packlist": "pnpm build && node tests/test-packlist.js",
    "test:release-tooling": "node tests/test-release-tooling.test.mjs",
    "test:all": "pnpm build && pnpm lint && pnpm check:security && pnpm audit:osv && pnpm test:unit && pnpm test:patch && node tests/test-packed-cli.js && node tests/test-packlist.js",
    "release:check": "pnpm test:all",
    "release:pack": "pnpm build && pnpm plugin:build && node scripts/create-release-artifact.mjs && node scripts/check-release-secrets.mjs .artifacts/release/metadata.json",
    "release:artifact:verify": "node scripts/verify-release-artifact.mjs .artifacts/release/metadata.json && node scripts/check-release-secrets.mjs .artifacts/release/metadata.json",
    "release:artifact:smoke": "node tests/test-packed-cli.js .artifacts/release/metadata.json",
    "test:standard": "pnpm build && node --test tests/test-standard.test.mjs",
    "test:unit": "node scripts/prepare-test-runtime.mjs && node --test --test-concurrency=4 --test-reporter=spec tests/*.test.mjs",
    "test:integration": "pnpm build && node tests/test-generated-apps.mjs",
    "test:live:delivery": "pnpm build && node tests/test-live-delivery.mjs",
    "format": "prettier --write src scripts tests plugins/codex/inspector \"assets/patches/*.mjs\" assets/ui",
    "format:check": "prettier --check src scripts tests plugins/codex/inspector \"assets/patches/*.mjs\" assets/ui",
    "plugin:build": "pnpm --dir plugins/codex/inspector build",
    "plugin:check": "pnpm --dir plugins/codex/inspector check",
    "plugin:preview": "pnpm --dir plugins/codex/inspector start",
    "test:patch": "node tests/test-braces-install.mjs && node tests/test-forge-install.mjs",
    "test:billing": "node tests/test-generated-apps.mjs billing",
    "test:native-ui": "pnpm build && pnpm --dir tests/native-ui typecheck && pnpm --dir tests/native-ui test",
    "native-ui:docs": "node scripts/native-ui-catalog.mjs --write",
    "native-ui:upstream": "node scripts/native-ui-catalog.mjs --upstream",
    "native-ui:registry": "node scripts/shadcn-registry.mjs",
    "native-ui:registry:docs": "node scripts/shadcn-registry.mjs --write",
    "native-ui:api": "node scripts/shadcn-registry.mjs --api",
    "native-ui:api:write": "node scripts/shadcn-registry.mjs --api --write",
    "native-ui:parity": "node scripts/shadcn-registry.mjs --complete"
  },
  "keywords": [
    "cli",
    "scaffold",
    "typescript",
    "expo",
    "hono",
    "cloudflare",
    "d1",
    "r2",
    "drizzle",
    "stripe",
    "revenuecat",
    "turborepo",
    "nextjs",
    "opennext"
  ],
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@types/node": "20.19.43",
    "hono": "4.13.13",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  }
}
