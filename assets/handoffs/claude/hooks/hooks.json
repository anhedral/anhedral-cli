{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "anhedral-handoff start claude-code",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "anhedral-handoff stop claude-code",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
